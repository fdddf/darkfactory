# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_INSPECTOR=        # Nemotron - copy the exact id from the playground catalog
MODEL_TESTGEN=
MODEL_FIXER=

# Nebius Sandboxes (contree auth writes ~/.config/contree/auth.ini)
NEBIUS_PROJECT_ID=

# Devin - must be a cog_ service-user key, apk_ keys are rejected
DEVIN_API_KEY=
DEVIN_ORG_ID=

# n8n
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# Tavily - researches escalations so the human arrives briefed
TAVILY_API_KEY=

# Audit signing. Set this for anything you demo.
AUDIT_SIGNING_KEY=

# Set to 1 once the PHP toolchain is available (enables php -l in pre-check)
DF_REAL_PHP=
